{
  "info": {
    "name": "Fuel Route Planner",
    "description": "Requests for GET /api/route/. Set base_url to where the server runs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base_url", "value": "http://127.0.0.1:8000" }],
  "item": [
    {
      "name": "Chicago to Denver, empty tank",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL&finish=Denver, CO",
          "host": ["{{base_url}}"],
          "path": ["api", "route", ""],
          "query": [
            { "key": "start", "value": "Chicago, IL" },
            { "key": "finish", "value": "Denver, CO" }
          ]
        }
      }
    },
    {
      "name": "New York to Los Angeles, full tank",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA&start_tank=full",
          "host": ["{{base_url}}"],
          "path": ["api", "route", ""],
          "query": [
            { "key": "start", "value": "New York, NY" },
            { "key": "finish", "value": "Los Angeles, CA" },
            { "key": "start_tank", "value": "full" }
          ]
        }
      }
    },
    {
      "name": "Coordinates as input",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=47.6062,-122.3321&finish=25.7617,-80.1918",
          "host": ["{{base_url}}"],
          "path": ["api", "route", ""],
          "query": [
            { "key": "start", "value": "47.6062,-122.3321" },
            { "key": "finish", "value": "25.7617,-80.1918" }
          ]
        }
      }
    },
    {
      "name": "Place outside the USA (400)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Paris, France&finish=Denver, CO",
          "host": ["{{base_url}}"],
          "path": ["api", "route", ""],
          "query": [
            { "key": "start", "value": "Paris, France" },
            { "key": "finish", "value": "Denver, CO" }
          ]
        }
      }
    }
  ]
}
